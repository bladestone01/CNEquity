# Byte-compiled / build artifacts
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/

# Test / lint caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
.venv-*/
venv/
env/

# Secrets & local config
.env
configs/*.local.toml
configs/stockdata.toml

# Data lake artifacts (never commit generated data)
data/
*.duckdb
*.duckdb.wal

# Runtime logs (prefer {data.root}/logs/; never commit either)
logs/

# Local AI / editor tooling
.claude/
.cursor/

# Editor / OS
.idea/
.vscode/
.DS_Store
