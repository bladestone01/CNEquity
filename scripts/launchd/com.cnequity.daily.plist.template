<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Generated by scripts/install_scheduler.sh — do not edit the installed copy;
     re-run the installer to regenerate. __PLACEHOLDERS__ are substituted there. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cnequity.daily</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO_ROOT__/scripts/daily_pipeline.sh</string>
  </array>

  <!-- Fire at 11:15 in the host's local time every day. Choose a time that
       lands comfortably after the 15:00 CST A-share close in the host's
       timezone — for a UTC+2/+3 host that is 16:15/17:15 CST — while leaving
       enough time for Workbench's downstream run. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>11</integer>
    <key>Minute</key>
    <integer>15</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <!-- This Mac is the gate/data host, not the mainland EastMoney extension
       host.  EquityLab's catchup adds the local breadth pass when the daily
       gate needs it; keeping the scheduled run on core avoids spending hours
       retrying capital/research endpoints that require a mainland egress. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>CNE_GROUPS</key>
    <string>core</string>
    <key>CNE_SOURCE_VANTAGE</key>
    <string>__SOURCE_VANTAGE__</string>
  </dict>

  <key>WorkingDirectory</key>
  <string>__REPO_ROOT__</string>

  <key>StandardOutPath</key>
  <string>__REPO_ROOT__/data/cnequity/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO_ROOT__/data/cnequity/logs/launchd.err.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
