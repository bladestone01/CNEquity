<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Generated by scripts/install_scheduler.sh — do not edit the installed copy;
     re-run the installer to regenerate. __PLACEHOLDERS__ are substituted there. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.stockdataengine.daily</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO_ROOT__/scripts/daily_pipeline.sh</string>
  </array>

  <!-- Fire at 16:05 local time every day; non-trading days are cheap no-ops. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>16</integer>
    <key>Minute</key>
    <integer>5</integer>
  </dict>

  <!-- If the Mac was asleep at 16:05, run once on wake. -->
  <key>RunAtLoad</key>
  <false/>

  <key>WorkingDirectory</key>
  <string>__REPO_ROOT__</string>

  <key>StandardOutPath</key>
  <string>__REPO_ROOT__/data/stock-data-engine/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO_ROOT__/data/stock-data-engine/logs/launchd.err.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
