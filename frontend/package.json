{
  "name": "ashare-lake-dashboard",
  "private": true,
  "version": "0.0.0",
  "description": "Bundle for asl serve. Built output is committed so pip install needs no node.",
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --format=iife --target=es2020 --outfile=../src/ashare_lake/serve/static/bundle.js --legal-comments=none",
    "check": "npm run build && git diff --exit-code -- ../src/ashare_lake/serve/static/bundle.js"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "echarts": "^6.1.0"
  }
}
